{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/*.mjs",
    "examples/*/src",
    "examples/*/tests",
    "examples/*/*.ts",
    "examples/*.ts",
    "vitest.config.ts",
    "scripts",
    "benchmarks/app",
    "benchmarks/bench",
    "benchmarks/tests",
    "benchmarks/test",
    "benchmarks/*.ts",
    "brand/readme-hero"
  ],
  "compilerOptions": {
    "allowJs": true
  },
  "exclude": ["packages/ui", "packages/dashboard", "examples/with-*"]
}
