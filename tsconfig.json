  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/*.mjs",
    "examples/shop*/src",
    "examples/shop*/tests",
    "examples/shop*/*.ts",
    "examples/*.ts",
    "vitest.config.ts",
    "scripts",
    "benchmarks/app",
