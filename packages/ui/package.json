{
  "name": "@danwo/ui",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    },
    "./source-alias": "./source-alias.ts"
  },
  "scripts": {
    "codegen": "panda codegen",
    "lib": "panda codegen && panda lib",
    "prepare": "panda codegen && panda lib"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-slider": "1.6.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "cmdk": "1.1.1",
    "input-otp": "1.5.0",
    "luxon": "3.7.2",
    "motion": "13.5.1",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "react-markdown": "10.1.0",
    "react-number-format": "5.4.5",
    "react-resizable-panels": "4.14.5",
    "react-tag-input": "6.10.6",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.35.0",
    "sonner": "2.0.8",
    "usehooks-ts": "3.1.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@pandacss/dev": "2.2.0",
    "@pandacss/preset-base": "2.2.0",
    "@tanstack/react-router": "1.170.44",
    "@types/luxon": "3.7.6",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "happy-dom": "20.14.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "@tanstack/react-router": "1.170.44",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
