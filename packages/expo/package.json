{
  "name": "@danwo/expo",
  "version": "0.0.0",
  "private": true,
  "description": "The danwo build of an Expo app: trusts danwo's per-run CA, built with `danwo build-android`.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/danwo-dev/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danwo-dev/danwo.git",
    "directory": "packages/expo"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@danwo/device": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
