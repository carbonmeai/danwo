{
  "name": "@danwo/device",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile devices for danwo tests: an Android emulator or an iOS Simulator bound to danwo's proxy and CA, driven through agent-device.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/device"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./toolchain": {
      "danwo-source": "./src/toolchain.ts",
      "types": "./dist/types/toolchain.d.ts",
      "default": "./src/toolchain.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@danwo/proxy": "workspace:*",
    "@danwo/runner": "workspace:*",
    "agent-device": "0.21.28"
  },
  "engines": {
    "node": ">=24"
  }
}
