{
  "name": "@danwo/proxy",
  "version": "0.0.0",
  "private": true,
  "description": "Routing proxy: provider routing, fault injection, HAR capture.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/danwo-dev/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danwo-dev/danwo.git",
    "directory": "packages/proxy"
  },
  "files": [
    "src",
    "preload.mjs",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "mockttp": "4.6.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@azure/msal-node": "7.1.0",
    "@bachs/sdk": "1.0.0",
    "@danwo/emulators": "workspace:*",
    "@types/express": "5.0.6",
    "@types/ws": "8.18.2",
    "ai": "7.0.143",
    "axios": "1.20.0",
    "express": "5.3.0",
    "express-openid-connect": "3.4.0",
    "google-auth-library": "11.3.1",
    "https-proxy-agent": "7.0.6",
    "openai": "7.38.0",
    "resend": "6.34.1",
    "stripe": "23.0.0",
    "twilio": "6.2.0",
    "undici": "7.30.1",
    "ws": "8.22.0",
    "zod": "4.6.1"
  },
  "engines": {
    "node": ">=24"
  }
}
