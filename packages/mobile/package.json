{
  "name": "@danwo/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile apps for danwo tests: builds an Expo, Xcode, Gradle or Flutter app to trust danwo's proxy, and runs it on an iOS Simulator or Android emulator bound to that proxy, driven through agent-device.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/mobile"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "danwo-source": "./src/build/index.ts",
      "types": "./dist/types/build/index.d.ts",
      "default": "./src/build/index.ts"
    },
    "./toolchain": {
      "danwo-source": "./src/toolchain.ts",
      "types": "./dist/types/toolchain.d.ts",
      "default": "./src/toolchain.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@danwo/proxy": "workspace:*",
    "@danwo/runner": "workspace:*",
    "agent-device": "0.21.30"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  }
}
