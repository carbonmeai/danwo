{
  "name": "@danwo/infra",
  "version": "0.0.0",
  "private": true,
  "description": "Fault proxies for the app's own data stores (Postgres, Redis) for danwo matrix.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/infra"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "ioredis": "6.0.0",
    "pg": "8.23.1"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  }
}
