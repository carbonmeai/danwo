{
  "name": "@danwo/skill",
  "version": "0.0.0",
  "private": true,
  "description": "What coding agents read about danwo: the shipped skill, task guides and the generated capability spec.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/danwo-dev/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danwo-dev/danwo.git",
    "directory": "packages/skill"
  },
  "files": [
    "src",
    "guides",
    "skill",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@danwo/emulators": "workspace:*",
    "@danwo/matrix": "workspace:*",
    "@danwo/proxy": "workspace:*",
    "@danwo/runner": "workspace:*",
    "@danwo/sdk": "workspace:*",
    "oxc-parser": "0.154.0"
  },
  "engines": {
    "node": ">=24"
  }
}
