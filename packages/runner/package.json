{
  "name": "@danwo/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Browser sessions, the agent's act/assert, the replay cache and the test runner.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/runner"
  },
  "files": [
    "src",
    "strip-types.mjs",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./runner": {
      "danwo-source": "./src/runner/index.ts",
      "types": "./dist/types/runner/index.d.ts",
      "default": "./src/runner/index.ts"
    },
    "./verdict": {
      "danwo-source": "./src/runner/verdict-words.ts",
      "types": "./dist/types/runner/verdict-words.d.ts",
      "default": "./src/runner/verdict-words.ts"
    },
    "./register": {
      "danwo-source": "./src/runner/register.ts",
      "types": "./dist/types/runner/register.d.ts",
      "default": "./src/runner/register.ts"
    },
    "./children": {
      "danwo-source": "./src/support/children.ts",
      "types": "./dist/types/support/children.d.ts",
      "default": "./src/support/children.ts"
    },
    "./strip-types": "./strip-types.mjs"
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.26",
    "@danwo/emulators": "workspace:*",
    "@danwo/infra": "workspace:*",
    "@danwo/matrix": "workspace:*",
    "@danwo/proxy": "workspace:*",
    "@vitest/expect": "5.0.3",
    "ai": "7.0.143",
    "picocolors": "1.1.1",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.119",
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.100",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@ai-sdk/perplexity": "5.0.15",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@tigrisdata/storage": "3.23.0",
    "@types/pngjs": "6.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
