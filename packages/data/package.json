{
  "name": "@danwo/data",
  "version": "0.0.0",
  "private": true,
  "description": "Snapshots of the app's own data stores (Postgres, SQLite, Redis) for danwo matrix.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/danwo-dev/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danwo-dev/danwo.git",
    "directory": "packages/data"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
