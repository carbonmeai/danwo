{
  "name": "@danwo/github",
  "version": "0.0.0",
  "private": true,
  "description": "Reports danwo runs to GitHub from Actions: a Check Run with annotations, a pull request comment and a job summary.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/github"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@danwo/matrix": "workspace:*",
    "@danwo/runner": "workspace:*"
  },
  "devDependencies": {
    "@danwo/emulators": "workspace:*",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  }
}
