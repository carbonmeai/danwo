{
  "name": "@danwo/playwright",
  "version": "0.0.0",
  "private": true,
  "description": "danwo's environments, emulators, faults, invariants and fault matrix for Playwright Test suites.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/playwright"
  },
  "bin": {
    "danwo-playwright": "./bin/danwo-playwright.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@danwo/emulators": "workspace:*",
    "@danwo/matrix": "workspace:*",
    "@danwo/proxy": "workspace:*",
    "@danwo/runner": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.60.0 <2"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  }
}
