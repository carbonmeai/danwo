{
  "name": "@danwo/init",
  "version": "0.0.0",
  "private": true,
  "description": "danwo init: detects a project, asks what to set up, and writes the config, an example test and the agent skill.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/init"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./catalog": {
      "danwo-source": "./src/catalog.ts",
      "types": "./dist/types/catalog.d.ts",
      "default": "./src/catalog.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@danwo/device": "workspace:*",
    "@danwo/mcp": "workspace:*",
    "@danwo/skill": "workspace:*"
  },
  "devDependencies": {
    "oxc-parser": "0.154.0"
  },
  "engines": {
    "node": ">=24"
  }
}
