{
  "name": "@danwo/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server for coding agents: run danwo tests, read failures, inspect pages and write tests.",
  "homepage": "https://danwo.dev",
  "bugs": "https://github.com/carbonmeai/danwo/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonmeai/danwo.git",
    "directory": "packages/mcp"
  },
  "files": [
    "src",
    "dist/types",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "danwo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/declarations.ts && node ../../scripts/pack-files.ts add",
    "postpack": "node ../../scripts/pack-files.ts remove"
  },
  "dependencies": {
    "@danwo/emulators": "workspace:*",
    "@danwo/matrix": "workspace:*",
    "@danwo/proxy": "workspace:*",
    "@danwo/recorder": "workspace:*",
    "@danwo/runner": "workspace:*",
    "@danwo/skill": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.64.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@danwo/sdk": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
