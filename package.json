{
  "name": "danwo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "examples/shop*",
    "benchmarks",
    "website"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ui && tsc --noEmit -p packages/dashboard && tsc --noEmit -p website",
    "declarations": "node scripts/declarations.ts",
    "release": "node scripts/release.ts",
    "ui:codegen": "bun run --cwd packages/ui lib",
    "test": "vitest run --project unit --project ui",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run ui:codegen && bun run format:check && bun run plain-js && bun run lint && bun run fallow && bun run typecheck && bun run declarations && bun run test",
    "test:slow": "vitest run --project slow --maxWorkers=4",
    "test:all": "vitest run",
    "fallow": "fallow --fail-on-issues",
    "plain-js": "node scripts/plain-js.ts",
    "audit": "node scripts/audit.ts",
    "bench": "bun run --cwd benchmarks bench",
    "website:dev": "bun run --cwd website dev",
    "website:build": "bun run --cwd website build",
    "website:preview": "bun run --cwd website preview",
    "readme-hero": "node brand/readme-hero/render.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24",
    "fallow": "3.34.1",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
