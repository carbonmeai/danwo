{
  "name": "danwo-example-with-compose",
  "private": true,
  "description": "A waitlist as a Jetpack Compose app on the Android emulator: it joins through a Hono API on Postgres that sends a welcome email through Resend.",
  "type": "module",
  "scripts": {
    "build:android": "danwo build-android android",
    "api": "node api/server.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "danwo test",
    "matrix": "danwo matrix tests/deterministic.danwo.ts --grep \"joins the waitlist\"",
    "matrix:plan": "danwo matrix tests/deterministic.danwo.ts --grep \"joins the waitlist\" --plan"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "resend": "6.34.1"
  },
  "devDependencies": {
    "@danwo/cli": "0.1.0-beta.0",
    "@danwo/mobile": "0.1.0-beta.0",
    "@danwo/proxy": "0.1.0-beta.0",
    "@danwo/sdk": "0.1.0-beta.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
