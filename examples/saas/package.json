{
  "name": "danwo-example-saas",
  "version": "0.0.0",
  "private": true,
  "description": "Relay, a team-notes app: workspaces on Clerk organizations, a Stripe trial and billing, Slack and Google integrations, live notes over Pusher and background jobs on Inngest, all emulated.",
  "type": "module",
  "scripts": {
    "build": "vite build web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "danwo test",
    "test:agentic": "danwo test tests/agentic.danwo.ts",
    "matrix": "danwo matrix tests/notes.danwo.ts --grep \"posts a published note\"",
    "matrix:plan": "danwo matrix tests/notes.danwo.ts --grep \"posts a published note\" --plan",
    "matrix:onboarding": "danwo matrix tests/onboarding.danwo.ts --grep \"signs up and starts a trial\"",
    "matrix:billing": "danwo matrix tests/billing.danwo.ts --grep \"the trial ends\"",
    "serve": "danwo serve"
  },
  "dependencies": {
    "@clerk/backend": "3.26.0",
    "@clerk/tanstack-react-start": "1.7.4",
    "@googleapis/calendar": "20.1.0",
    "@hono/node-server": "2.1.5",
    "@slack/web-api": "8.2.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "11.3.1",
    "hono": "4.13.13",
    "inngest": "4.25.0",
    "pg": "8.23.1",
    "pusher": "5.3.4",
    "pusher-js": "8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "stripe": "23.0.0",
    "svix": "2.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@danwo/cli": "0.1.2",
    "@danwo/sdk": "0.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "inngest-cli": "1.46.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
