{{define "content"}}
<div class="page-header">
  <h1 class="page-title">Notes your whole team can find</h1>
  <p class="page-description">Start free. Move to the Team plan when everyone joins.</p>
</div>

<div class="plans">
  <section class="card" aria-labelledby="plan-free">
    <div class="card-header">
      <h2 class="card-title" id="plan-free">Free</h2>
      <p class="card-description">For trying Quillwork with a few people</p>
    </div>
    <div class="card-body"><span class="price">$0</span> <span class="muted">a month</span></div>
  </section>
  <section class="card" aria-labelledby="plan-team">
    <div class="card-header">
      <h2 class="card-title" id="plan-team">Team</h2>
      <p class="card-description">Unlimited notes and members</p>
    </div>
    <div class="card-body"><span class="price">$24</span> <span class="muted">a month</span></div>
  </section>
</div>

{{if .Account}}
<p><a class="btn btn-primary" href="/account">Go to your account</a></p>
{{else}}
<section class="card narrow" aria-labelledby="signup-title">
  <div class="card-header">
    <h2 class="card-title" id="signup-title">Create your team's account</h2>
  </div>
  <form class="card-body stack" method="post" action="/signup" novalidate>
    {{if .Error}}<p class="toast toast-error" role="alert">{{.Error}}</p>{{end}}
    <div class="field">
      <label class="label" for="email">Work email</label>
      <input id="email" name="email" class="input" type="email" autocomplete="email" value="{{.Form.Email}}"
        {{if .Form.EmailError}}aria-invalid="true" aria-describedby="email-error"{{end}} />
      {{if .Form.EmailError}}<p class="error" id="email-error">{{.Form.EmailError}}</p>{{end}}
    </div>
    <div class="field">
      <label class="label" for="team">Team name</label>
      <input id="team" name="team" class="input" type="text" value="{{.Form.Team}}"
        {{if .Form.TeamError}}aria-invalid="true" aria-describedby="team-error"{{end}} />
      {{if .Form.TeamError}}<p class="error" id="team-error">{{.Form.TeamError}}</p>{{end}}
    </div>
    <button type="submit" class="btn btn-primary">Create account</button>
  </form>
</section>
{{end}}
{{end}}
