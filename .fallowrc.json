{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "workspaces": {
    "patterns": ["packages/*", "examples/*"]
  },
  "health": {
    "maxCyclomatic": 10,
    "maxCognitive": 15
  },
  "duplicates": {
    "minOccurrences": 2,
    "ignore": ["packages/*/test/fixtures/**/app.ts", "packages/*/test/fixtures/*-app.ts"]
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "dynamicallyLoaded": [
    "**/danwo.config.ts",
    "**/*.danwo.ts",
    "**/playwright.config.ts",
    "**/*.spec.ts",
    "packages/*/test/fixtures/**",
    "packages/recorder/src/page-script.ts"
  ],
  "ignoreDependencies": ["@danwo/example-shop"]
}
